# Copy to .env and fill in. Never commit .env. All keys except DATABASE_URL / SECRET_KEY are optional:
# a missing key turns that check into "not_configured", it never fakes a result.

# ---- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://threatdesk:threatdesk@localhost:5432/threatdesk
SECRET_KEY=change-me-to-a-long-random-string
ENV=dev                      # dev | prod (prod => Secure cookies, SECRET_KEY mandatory; default prod on Vercel)
# POSTGRES_URL is used when DATABASE_URL is unset (set by the Supabase/Neon integrations on Vercel).

# ---- Serverless (Vercel) -----------------------------------------------------
SERVERLESS=                  # auto-detected on Vercel; true = no in-process worker, jobs run in polls and /cron/tick

# ---- Error reporting (optional) ------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ---- Monitoring --------------------------------------------------------------
CRON_SECRET=                 # header X-Cron-Secret for POST /cron/tick (endpoint returns 503 when unset)
PUBLIC_BASE_URL=             # e.g. https://threatdesk.onrender.com (report links, alert links)

# ---- AI (optional) -----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Sources / reputation (optional) -----------------------------------------
YOUTUBE_API_KEY=
SAFE_BROWSING_API_KEY=
VT_API_KEY=
URLHAUS_AUTH_KEY=

# ---- Web-search discovery of public profile pages (optional, pick one or both)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_API_KEY=

# ---- Email relay for alerts (optional; recipients are per organisation in Settings -> Alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- DNS for checks: comma-separated servers (default 1.1.1.1,8.8.8.8) or "system"
DNS_SERVERS=

# ---- Public scam/phishing lists (on by default). OpenPhish is non-commercial only: SCAM_LIST_EXCLUDE=openphish
SCAM_LISTS=on                # default off on serverless hosts (multi-minute download per instance)
SCAM_LIST_EXCLUDE=
CACHE_DIR=.cache

# ---- PhishTank works without a key; a key raises the rate limit
PHISHTANK_APP_KEY=
PHISHTANK_USERNAME=threatdesk

# ---- Instagram/TikTok/Facebook profiles via Apify (paid per profile, capped at $0.05 per run)
APIFY_TOKEN=
APIFY_INSTAGRAM_ABOUT=false

# ---- Worker / misc (defaults shown)
START_WORKER=true
WORKER_CONCURRENCY=3
JOB_TIMEOUT=120
CONTACTS_PATH=contacts.yaml

# ---- Heavy, off by default
ENABLE_SCREENSHOTS=false
