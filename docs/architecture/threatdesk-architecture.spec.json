  "cards": [
    {
      "dot": "cyan",
      "title": "Presentation & Intake",
      "items": [
        "FastAPI app with Jinja2 SSR, strict Content Security Policy, and signed CSRF tokens",
        "Public intake page for customer scam submissions + analyst investigation portal"
      ]
    },
    {
      "dot": "emerald",
      "title": "Async Job Execution",
      "items": [
        "PostgreSQL `jobs` table queue with atomic row claims (FOR UPDATE SKIP LOCKED)",
        "Single-process async worker with semaphore-capped concurrency (3 concurrent jobs) and 5-min cron ticker"
      ]
    },
    {
      "dot": "violet",
      "title": "Discovery & Investigation",
      "items": [
        "Multi-source discovery (permutations, CT logs, Play Store, iTunes, Bluesky, YouTube, Brave/Google Search)",
        "Deep collection pipeline running DNS, RDAP, TLS, Wayback, page fetch with SSRF guard, and scam list lookups"
      ]
    },
    {
      "dot": "rose",
      "title": "Scoring, RiskView & Takedown",
      "items": [
        "60 scoring rules with 35-point identity-gate cap for accounts and apps without corroborating evidence",
        "RiskView classification with multi-source confidence calculation",
        "Audit trail with append-only SHA-256 hashed evidence, automated takedown packets, and SMTP/webhook alerting"
      ]
    },
    {
      "dot": "cyan",
      "title": "Official-Asset Exclusion & Look-alikes",
      "items": [
        "Brand profile holds official sites, social accounts, apps and publishers; each is verified (DNS TXT, meta tag, bio code, assetlinks.json)",
        "Verified official assets and allow-listed items short-circuit to score 0, “Official/whitelisted asset”, before any rule runs",
        "Look-alike engine flags character swaps, added words, spacing/hyphen changes and homoglyphs, with guards against over-flagging normal names",
        "Apps: title similarity, icon pHash vs official logo, developer not on the official publisher list, description resemblance"
      ]
    }
  ]
